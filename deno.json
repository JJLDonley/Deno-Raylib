    "init": "deno run -A Tools/init.ts",
    "web:init": "deno run -A Tools/init.ts --template web",
    "desktop:init": "deno run -A Tools/init.ts --template desktop",
    "update:api": "deno run --allow-net=raw.githubusercontent.com --allow-read --allow-write --allow-run Bindings/Generators/update_api.ts",
    "setup:web": "deno run -A Scripts/setup_emscripten.ts && deno task prepare:web",
    "prepare:web": "deno run --allow-net=github.com,release-assets.githubusercontent.com --allow-read --allow-write --allow-run Scripts/prepare_web.ts",
    "build:web": "deno run -A Scripts/build_web.ts",
    "build:native": "deno run -A Scripts/build_native.ts",
    "example": "deno run --allow-ffi --allow-read",
    "examples:assets": "deno run --allow-write Examples/Resources/generate_assets.ts",
    "examples:check": "deno check Examples/*/*.ts",
    "generate": "deno run --allow-read --allow-write Bindings/Generators/generate_layouts.ts && deno run --allow-read --allow-write Bindings/Generators/generate_layouts.ts --web && deno run --allow-read --allow-write Bindings/Generators/generate_ffi_structs.ts && deno run --allow-read --allow-write Bindings/Generators/generate_structs.ts && deno run --allow-read --allow-write Bindings/Generators/generate_structs.ts --web && deno run --allow-read --allow-write Bindings/Generators/generator.ts && deno run --allow-read --allow-write Bindings/Generators/generate_rlgl.ts && deno run --allow-read --allow-write Bindings/Generators/generate_modules.ts && deno run --allow-read --allow-write Bindings/Generators/generate_webapp.ts && deno run --allow-read --allow-write Bindings/Generators/generate_wasm_bridge.ts && deno run --allow-read --allow-write Bindings/Generators/generate_docs.ts && deno fmt deno.json Bindings Raylib Modules Web Scripts Tools"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "./Bindings/global.d.ts"
    ]
  },
  "imports": {
    "path": "jsr:@std/path@1.1.4",
